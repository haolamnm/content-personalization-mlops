# Copy to .env (gitignored) — consumed by platform/infra/compose.data.yaml
# Local-only learning stack: strong values still required by the images themselves.

POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlops

MONGO_ROOT_USER=mlops
MONGO_ROOT_PASSWORD=change-me

MINIO_ROOT_USER=mlops-admin
MINIO_ROOT_PASSWORD=change-me-8plus

KAFKA_CLUSTER_ID=ClVGOYmUQ5mwKlbb0bnGzw

# Optional host-port overrides for machines where defaults collide with local services
# (e.g. ThinkBook runs a system postgresql on 5432). Defaults match the Mac.
#POSTGRES_HOST_PORT=5432
#MONGO_HOST_PORT=27017
#MINIO_API_HOST_PORT=9000
#MINIO_CONSOLE_HOST_PORT=9001

# Debezium Connect REST API (cdc slice)
#CONNECT_HOST_PORT=8083
#GATEWAY_HOST_PORT=8080
